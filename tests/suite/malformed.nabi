// Malformed input: each error has its kind, its line and column, and a
// message that says what to write.

use pkg::tests::suite::error;
use pkg::{Dialect, ErrorKind};

fn d() -> Dialect { Dialect::new().has_header(false) }

#[test]
fn unclosed_quote() {
    let e = error(d(), "a,b\nc,\"open\nmore\n");
    assert(e.kind == ErrorKind::UnclosedQuote, e.message());
    assert(e.line == 2 && e.column == 3, e.message());
    assert(e.message() == "line 2, column 3: a quoted field is never closed; end it with `\"` (write a quote inside a field as `\"\"`)", e.message());
    let tail = error(d(), "\"a\"\"");
    assert(tail.kind == ErrorKind::UnclosedQuote, tail.message());
    let esc = error(d().escape('\\'), "\"a\\");
    assert(esc.kind == ErrorKind::UnclosedQuote, esc.message());
}

#[test]
fn text_after_quote() {
    let e = error(d(), "x\n\"ab\"c,d\n");
    assert(e.kind == ErrorKind::AfterQuote && e.line == 2 && e.column == 5, e.message());
    assert(e.message().contains("quote the whole field"), e.message());
    let u = error(d(), "é,\"ü\"x\n");
    assert(u.column == 6, u.message());
}

#[test]
fn field_counts() {
    let e = error(d(), "a,b\nc,d\ne\n");
    assert(e.kind == ErrorKind::FieldCount && e.line == 3, e.message());
    assert(e.message().contains("Dialect::flexible(true)"), e.message());
}

#[test]
fn not_utf8() {
    let bytes: List<u8> = [0x61u8, 0x0Au8, 0x62u8, 0xFFu8, 0x0Au8];
    let r = d().from_bytes(bytes);
    let n = try r.count() as i64 catch e {
        assert(e.kind == ErrorKind::Utf8 && e.line == 2 && e.column == 2, e.message());
        assert(e.message().contains("convert the file to UTF-8"), e.message());
        -1
    };
    assert(n == -1);
    let s = d().reader(pkg::tests::suite::Chunks { data: bytes, at: 0, step: 1 });
    let m = try s.count() as i64 catch e {
        assert(e.kind == ErrorKind::Utf8 && e.line == 2, e.message());
        -1
    };
    assert(m == -1);
}

#[test]
fn edge_inputs() {
    assert(pkg::tests::suite::plain("") == List::<List<str>>::new());
    assert(pkg::tests::suite::plain("\n\n\n") == List::<List<str>>::new());
    let r = pkg::from_str("");
    assert((try! r.headers()).is_empty() && try! r.next() is none);
    let only = pkg::from_str("a,b\n");
    assert((try! only.headers()).len() == 2 && try! only.count() == 0);
}

#[test]
fn lone_quote() {
    let e = error(d(), "\"");
    assert(e.kind == ErrorKind::UnclosedQuote && e.line == 1 && e.column == 1, e.message());
}

#[derive(pkg::Csv)]
struct Pair { a: i64; b: i64; }

/// Reads with `next`, skipping errors, until the end (or 100 calls):
/// the records read and the errors seen.
fn skim(r: pkg::Reader) -> (usize, List<ErrorKind>) {
    let n: usize = 0;
    let errs: List<ErrorKind> = List::new();
    for _ in 0..100 {
        let got = try r.next() catch e {
            errs.push(e.kind);
            continue;
        };
        if got is none { return (n, errs); }
        n += 1;
    }
    panic(f"no end after 100 calls: {n} records, errors {errs:?}");
}

#[test]
fn structural_error_ends() {
    let flex = Dialect::new().flexible(true);
    let rows = flex.from_str("a,b\n1,\"x\n2,3\n").decode::<Pair>();
    let calls: usize = 0;
    let errs: List<ErrorKind> = List::new();
    loop {
        calls += 1;
        assert(calls < 100, "the loop does not end");
        let r = try rows.next() catch e {
            errs.push(e.kind);
            continue;
        };
        if r is none { break; }
    }
    assert(errs == [ErrorKind::UnclosedQuote], f"{errs:?}");

    let (n, e) = skim(d().from_str("1\n2\n\"ab\"c\n3\n"));
    assert(n == 2 && e == [ErrorKind::AfterQuote], f"{n} {e:?}");
    let bytes: List<u8> = [0x61u8, 0x0Au8, 0x62u8, 0xFFu8, 0x0Au8, 0x63u8, 0x0Au8];
    let (n, e) = skim(d().from_bytes(bytes));
    assert(n == 0 && e == [ErrorKind::Utf8], f"{n} {e:?}");
    let s = d().reader(pkg::tests::suite::Chunks { data: "a\n\"b\nc\n".as_bytes().to_list(), at: 0, step: 1 });
    let (n, e) = skim(s);
    assert(n == 1 && e == [ErrorKind::UnclosedQuote], f"{n} {e:?}");
    let cols: List<List<str>> = [List::new()];
    let quoted: List<List<usize>> = [List::new()];
    let r = d().from_str("\"a\n");
    let got = try r.read_columns(cols, quoted, 10) catch _ { 7 };
    assert(got == 7);
    assert(try! r.read_columns(cols, quoted, 10) == 0);
}

#[test]
fn field_count_goes_on() {
    let (n, e) = skim(Dialect::new().from_str("a,b\n1,2\n3\n4,5\n"));
    assert(n == 2 && e == [ErrorKind::FieldCount], f"{n} {e:?}");
}
